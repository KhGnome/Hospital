@model List<DoctorProfile>
@{
    ViewData["Title"] = "Лікарі";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Лікарі</h3>
    <a asp-action="CreateDoctor" class="btn btn-success">+ Додати лікаря</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle bg-white">
        <thead class="table-light">
            <tr>
                <th>ПІБ</th>
                <th>Email</th>
                <th>Телефон</th>
                <th>Спеціальність</th>
                <th>Кабінет</th>
                <th>Стаж</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@(d.User?.FullName)</td>
                    <td>@(d.User?.Email)</td>
                    <td>@(d.User?.PhoneNumber)</td>
                    <td>@(d.Specialty?.Name)</td>
                    <td>@d.Office</td>
                    <td>@d.Experience р.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
