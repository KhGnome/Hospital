@model List<Appointment>
@{
    ViewData["Title"] = "Усі записи";
}

<h3 class="mb-3">Усі записи</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">Записів поки немає.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-light">
                <tr>
                    <th>Дата і час</th>
                    <th>Пацієнт</th>
                    <th>Лікар</th>
                    <th>Спеціальність</th>
                    <th>Скарга</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var shortComplaint = a.Complaint.Length > 50 ? a.Complaint.Substring(0, 50) + "..." : a.Complaint;
                    <tr>
                        <td class="text-nowrap">@a.DateTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(a.Patient?.FullName)</td>
                        <td>@(a.Doctor?.User?.FullName)</td>
                        <td>@(a.Doctor?.Specialty?.Name)</td>
                        <td>@shortComplaint</td>
                        <td><span class="badge @a.Status.GetBadge()">@a.Status.GetName()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
