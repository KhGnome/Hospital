@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Лікарня</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <img src="~/images/greencross.png" alt="" class="brand-icon" />
                <span>Лікарня</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Головна</a></li>

                    @* Меню пацієнта *@
                    @if (User.IsInRole("Patient"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Patient" asp-action="ChooseSpecialty">Записатися до лікаря</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Patient" asp-action="MyAppointments">Мої записи</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Patient" asp-action="Prescriptions">Мої ліки</a></li>
                    }

                    @* Меню лікаря *@
                    @if (User.IsInRole("Doctor"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Doctor" asp-action="Index">Мої прийоми</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Doctor" asp-action="Search">Пошук пацієнта</a></li>
                    }

                    @* Меню адміна *@
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Панель</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Specialties">Спеціальності</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Doctors">Лікарі</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Appointments">Усі записи</a></li>
                    }
                </ul>

                <ul class="navbar-nav align-items-lg-center">
                    @if (currentUser != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Profile">@currentUser.FullName</a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Вийти</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Вхід</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Реєстрація</a></li>
                    }
                </ul>
            </div>
            
        </div>
    </nav>

<div class="page-content flex-grow-1">
    <div class="container">
        @* Сповіщення (TempData) *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>
    </div>

    <footer class="text-center text-muted py-3 border-top">
        &copy; @DateTime.Now.Year Лікарня: онлайн-запис до лікаря (навчальний проєкт)
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
