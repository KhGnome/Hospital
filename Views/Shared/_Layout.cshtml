@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Лікарня</title>
    <script>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/redesign.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    @* ===== Шапка: велика зверху, зменшується при прокручуванні ===== *@
    <header class="site-header" id="siteHeader">
        <nav class="navbar navbar-expand-xl">
            <div class="container">
                <a class="site-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/greencross.png" alt="" class="site-brand__logo" />
                    <span class="site-brand__text">
                        <strong>Лікарня</strong>
                        <small>онлайн-запис до лікаря</small>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu"
                        aria-controls="mainMenu" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse site-menus" id="mainMenu">

                    @* Верхній рядок (ховається при прокручуванні) *@
                    <ul class="navbar-nav site-top">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">Про нас</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About" asp-fragment="contacts">Контакти</a></li>
                        @if (currentUser != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-1"></i>@currentUser.FullName</a>
                            </li>
                            <li class="nav-item ms-xl-2">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Вийти</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Вхід</a></li>
                            <li class="nav-item ms-xl-2"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Реєстрація</a></li>
                        }
                    </ul>

                    @* Основне меню *@
                    <ul class="navbar-nav site-main">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Головна</a></li>

                        @* Меню пацієнта *@
                        @if (User.IsInRole("Patient"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Patient" asp-action="ChooseSpecialty">Записатися до лікаря</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Patient" asp-action="MyAppointments">Мої записи</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Patient" asp-action="Prescriptions">Мої ліки</a></li>
                        }

                        @* Меню лікаря *@
                        @if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Doctor" asp-action="Index">Мої прийоми</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Doctor" asp-action="Search">Пошук пацієнта</a></li>
                        }

                        @* Меню адміна *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Панель</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Specialties">Спеціальності</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Doctors">Лікарі</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Appointments">Усі записи</a></li>
                        }

                        @* Гість: пункт «Спеціальності» (інше є у верхньому рядку) *@
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="specialties">Спеціальності</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="page-content flex-grow-1">

        @* Велика картинка на всю ширину (на головній і «Про нас») *@
        @await RenderSectionAsync("Hero", required: false)

        <div class="container page-body">
            @* Сповіщення (TempData) *@
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
                </div>
            }

            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>
    </div>

    @* ===== Підвал ===== *@
    <footer class="site-footer">
        <div class="container">
            <div class="row gy-4 site-footer__main">

                <div class="col-lg-4">
                    <a class="site-footer__brand" asp-controller="Home" asp-action="Index">
                        <img src="~/images/greencross.png" alt="" />
                        <span>Лікарня</span>
                    </a>
                    <p class="site-footer__about">
                        Онлайн-запис до лікаря: оберіть спеціальність, лікаря та зручний час за кілька хвилин.
                        Результати прийомів і призначені ліки завжди у вашому кабінеті.
                    </p>
                    <ul class="footer-contacts">
                        <li><i class="bi bi-geo-alt-fill"></i><span>м. Київ, вул. Здоров'я, 1</span></li>
                        <li><i class="bi bi-telephone-fill"></i><a href="tel:+380441234567">+380 44 123 45 67</a></li>
                        <li><i class="bi bi-envelope-fill"></i><a href="mailto:info@@hospital.ua">info@@hospital.ua</a></li>
                        <li><i class="bi bi-clock-fill"></i><span>Щодня 9:00 – 17:00</span></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Пацієнтам</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Patient" asp-action="ChooseSpecialty">Записатися до лікаря</a></li>
                        <li><a asp-controller="Patient" asp-action="MyAppointments">Мої записи</a></li>
                        <li><a asp-controller="Patient" asp-action="Prescriptions">Мої ліки</a></li>
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li><a asp-controller="Account" asp-action="Register">Реєстрація</a></li>
                        }
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Інформація</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Головна</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="specialties">Спеціальності</a></li>
                        <li><a asp-controller="Home" asp-action="About">Про нас</a></li>
                        <li><a asp-controller="Home" asp-action="About" asp-fragment="contacts">Контакти</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Співробітникам</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Account" asp-action="Login">Вхід</a></li>
                        <li><a asp-controller="Doctor" asp-action="Index">Мої прийоми</a></li>
                        <li><a asp-controller="Admin" asp-action="Index">Панель адміністратора</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h6 class="footer-title">Ваша думка</h6>
                    <p class="footer-note">Нам важливо знати, що можна покращити.</p>
                    <a class="btn btn-light btn-sm" href="mailto:info@@hospital.ua?subject=Відгук">Написати нам</a>
                </div>
            </div>

            <div class="site-footer__bottom">
                <span>&copy; @DateTime.Now.Year Лікарня: онлайн-запис до лікаря (навчальний проєкт)</span>
                <a href="#" class="to-top" id="toTop"><i class="bi bi-arrow-up-circle me-1"></i>Нагору</a>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/redesign.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
