@model List<Specialty>
@{
    ViewData["Title"] = "Головна";
    var isDoctor = User.IsInRole("Doctor");
    var isAdmin = User.IsInRole("Admin");
    var canBook = !isDoctor && !isAdmin;   // гість або пацієнт
    var i = 0;
}
@functions {
    // Іконка Bootstrap Icons за назвою спеціальності (нові спеціальності отримують іконку за замовчуванням)
    static string IconFor(string? name)
    {
        var n = (name ?? "").Trim().ToLowerInvariant();
        if (n.Contains("кардіо")) return "activity";
        if (n.Contains("терапев")) return "heart-pulse";
        if (n.Contains("хірург")) return "scissors";
        if (n.Contains("окуліст") || n.Contains("офтальм")) return "eye";
        if (n == "лор" || n.Contains("отоларинг")) return "soundwave";
        if (n.Contains("невролог")) return "lightning-charge";
        if (n.Contains("дермато")) return "bandaid";
        if (n.Contains("педіатр")) return "emoji-smile";
        return "plus-circle";
    }
}

@section Hero {
    <section class="hero">
        <div class="container hero__inner">
            <h1>Лікарня: <span class="nowrap">онлайн-запис</span> до лікаря</h1>
            <p class="hero__lead">
                Оберіть спеціальність, лікаря та зручний час. Записатися можна за кілька хвилин,
                а результати прийому й призначені ліки завжди будуть у вашому кабінеті.
            </p>
            <div class="hero__actions">
                @if (isAdmin)
                {
                    <a class="hero-btn" asp-controller="Admin" asp-action="Index">Панель адміністратора</a>
                    <a class="hero-btn" asp-controller="Admin" asp-action="Doctors">Лікарі</a>
                    <a class="hero-btn" asp-controller="Admin" asp-action="Appointments">Усі записи</a>
                }
                else if (isDoctor)
                {
                    <a class="hero-btn" asp-controller="Doctor" asp-action="Index">Мої прийоми</a>
                    <a class="hero-btn" asp-controller="Doctor" asp-action="Search">Пошук пацієнта</a>
                    <a class="hero-btn" asp-controller="Home" asp-action="About">Про нас</a>
                }
                else
                {
                    <a class="hero-btn" asp-controller="Patient" asp-action="ChooseSpecialty">Записатися онлайн</a>
                    <a class="hero-btn" asp-controller="Home" asp-action="About" asp-fragment="contacts">Як нас знайти</a>
                    <a class="hero-btn" asp-controller="Home" asp-action="About">Про нас</a>
                }
            </div>
        </div>
    </section>
}

<section class="section" id="specialties">
    <h2 class="section__title reveal">Наші спеціальності</h2>
    <p class="section__sub reveal" style="--i:1">Оберіть напрям, щоб побачити лікарів і вільний час для запису.</p>

    @if (Model.Count == 0)
    {
        <p class="text-muted">Спеціальності ще не додано.</p>
    }
    else
    {
        <div class="spec-grid">
            @foreach (var s in Model)
            {
                <a class="spec-card reveal" style="--i:@(Math.Min(i++, 8))"
                   href="@(canBook ? Url.Action("Doctors", "Patient", new { specialtyId = s.Id }) : null)">
                    <span class="spec-card__icon"><i class="@("bi bi-" + IconFor(s.Name))"></i></span>
                    <span class="spec-card__body">
                        <span class="spec-card__title">@s.Name</span>
                        <span class="spec-card__meta">Лікарів: @s.Doctors.Count</span>
                    </span>
                    <i class="bi bi-arrow-right spec-card__arrow"></i>
                </a>
            }
        </div>
    }
</section>

<section class="section">
    <h2 class="section__title reveal">Як записатися</h2>
    <p class="section__sub reveal" style="--i:1">Три прості кроки.</p>
    <div class="info-grid">
        <div class="info-card reveal" style="--i:0">
            <div class="info-card__num">1</div>
            <h5>Оберіть спеціальність</h5>
            <p>Знайдіть потрібний напрям і перегляньте лікарів, їхній стаж і кабінет.</p>
        </div>
        <div class="info-card reveal" style="--i:1">
            <div class="info-card__num">2</div>
            <h5>Виберіть дату й час</h5>
            <p>Вільні слоти по 30 хвилин показано одразу. Зайнятий час недоступний.</p>
        </div>
        <div class="info-card reveal" style="--i:2">
            <div class="info-card__num">3</div>
            <h5>Прийдіть на прийом</h5>
            <p>Статус запису, діагноз і призначені ліки зберігаються у вашому кабінеті.</p>
        </div>
    </div>
</section>
