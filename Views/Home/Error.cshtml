@{
    ViewData["Title"] = "Помилка";
    int? code = ViewBag.Code as int?;
}

<div class="text-center py-5">
    @if (code == 404)
    {
        <h1 class="display-4">404</h1>
        <h4>Сторінку не знайдено</h4>
        <p class="text-muted">Можливо, адресу введено неправильно або сторінку видалено.</p>
    }
    else if (code == 403)
    {
        <h1 class="display-4">403</h1>
        <h4>Доступ заборонено</h4>
    }
    else
    {
        <h1 class="display-4">Ой!</h1>
        <h4>Сталася помилка</h4>
        <p class="text-muted">Спробуйте ще раз пізніше.</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">На головну</a>
</div>
