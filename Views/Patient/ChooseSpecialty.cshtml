@model List<Specialty>
@{
    ViewData["Title"] = "Вибір спеціальності";
}

<h3 class="mb-1">Запис до лікаря</h3>
<p class="text-muted">Крок 1 з 3: оберіть спеціальність</p>

<div class="row">
    @foreach (var s in Model)
    {
        <div class="col-sm-6 col-lg-4 mb-3">
            <div class="card card-hover h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@s.Name</h5>
                    <p class="text-muted">Лікарів: @s.Doctors.Count</p>
                    <a asp-action="Doctors" asp-route-specialtyId="@s.Id" class="btn btn-primary mt-auto">Обрати</a>
                </div>
            </div>
        </div>
    }
</div>
